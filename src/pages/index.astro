---
import { site, t } from '../lib/content';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.person.name}</title>
    <link rel="canonical" href={new URL('/en/', site.person.siteUrl).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site.person.siteUrl).href} />
    <link rel="alternate" hreflang="pt-PT" href={new URL('/pt/', site.person.siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', site.person.siteUrl).href} />
    <meta name="theme-color" content="#090E13" />
    <script is:inline>
      (function () {
        var lang = null;
        try { lang = localStorage.getItem('cb-lang'); } catch (e) {}
        if (lang !== 'en' && lang !== 'pt') {
          lang = /^pt\b/i.test(navigator.language || '') ? 'pt' : 'en';
        }
        location.replace('/' + lang + '/' + location.hash);
      })();
    </script>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-content: center; gap: 1rem; text-align: center; background: #090e13; color: #e9eff2; font: 1.1rem/1.5 system-ui, sans-serif; }
      a { color: #19d8e8; margin: 0 .6rem; }
    </style>
  </head>
  <body>
    <p>{site.person.name}</p>
    <p>
      <a href="/pt/" hreflang="pt-PT" lang="pt-PT">{t('pt', 'lang.pt')}</a>
      <a href="/en/" hreflang="en" lang="en">{t('en', 'lang.en')}</a>
    </p>
  </body>
</html>
