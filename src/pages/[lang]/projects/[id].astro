---
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { projectShot } from '../../../lib/screens';
import { personRef } from '../../../lib/seo';
import { LANGS, allProjects, site, t, homePath, projectPath, htmlLang, projectLinks, type Lang, type Project } from '../../../lib/content';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => allProjects.map((project) => ({ params: { lang, id: project.id }, props: { project } })));
}

interface Props { project: Project }
const lang = Astro.params.lang as Lang;
const { project } = Astro.props;
const shot = projectShot(lang, project.id);
const url = new URL(projectPath(lang, project.id), site.person.siteUrl).href;
const sameAs = projectLinks(project, lang).map((l) => l.href);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name[lang],
  headline: project.name[lang],
  description: project[lang].hook,
  url,
  mainEntityOfPage: url,
  inLanguage: htmlLang[lang],
  genre: project[lang].cat,
  creativeWorkStatus: project[lang].status,
  keywords: project.stack.join(', '),
  author: personRef(),
  isPartOf: { '@type': 'WebSite', name: site.person.name, url: site.person.siteUrl },
  ...(sameAs.length ? { sameAs } : {}),
};
---
<Base
  lang={lang}
  title={`${project.name[lang]} — ${site.person.name}`}
  description={project[lang].hook}
  paths={{ en: projectPath('en', project.id), pt: projectPath('pt', project.id) }}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="project-page">
    <p><a class="back" href={`${homePath(lang)}#p-${project.id}`}>← {t(lang, 'p.back')}</a></p>
    <p class="lede">{project[lang].hook}</p>
    {shot && (
      <figure class={`device-frame device-${shot.device}`}>
        <img src={shot.page.src} width={shot.page.width} height={shot.page.height} alt="" decoding="async" />
      </figure>
    )}
    <CaseStudy project={project} lang={lang} />
  </div>
</Base>
