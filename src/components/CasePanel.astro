---
import CaseStudy from './CaseStudy.astro';
import { allProjects, t, projectPath, homePath, otherLang, htmlLang, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const other = otherLang(lang);
---
<!--
  Case-study panel (SPEC §9). Each project's content is pre-rendered in a <template>
  in the page language; the panel clones the one it needs. Without JS, the rows and
  cards link to the project pages instead.
-->
<dialog class="drawer" aria-labelledby="case-title" data-case-panel>
  <div class="drawer-tools">
    <!-- The page behind is inert while the panel is open, so the panel carries its own language switch. -->
    <a class="case-lang mono" href={homePath(other)} hreflang={htmlLang[other]} lang={htmlLang[other]} data-lang-switch={other} aria-label={`${other.toUpperCase()} – ${t(other, `lang.${other}`)}`}>{other.toUpperCase()}</a>
    <button type="button" class="close" data-case-close>{t(lang, 'd.close')}</button>
  </div>
  <div data-case-body></div>
</dialog>
{allProjects.map((p) => (
  <template data-case={p.id}>
    <CaseStudy project={p} lang={lang} headingLevel="h2" titleId="case-title">
      <p class="page-link"><a href={projectPath(lang, p.id)}>{t(lang, 'd.page')} →</a></p>
    </CaseStudy>
  </template>
))}

<script>
  import { initCasePanel } from '../scripts/casePanel';
  initCasePanel();
</script>
